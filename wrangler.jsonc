{
  "$schema": "https://unpkg.com/wrangler@4.154.0/config-schema.json",
  "name": "ely-tea-party-website",
  "account_id": "221784d24eb2a95d148bc96b6f06d6be",
  "compatibility_date": "2026-10-27",
  // The Worker answers the skin market's API and per-skin pages; everything else is dist/ as built.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/skins/*", "/en/skins/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ely-tea-party-market", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SKINS", "bucket_name": "ely-tea-party-skins" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@auth.elyteaparty.com"] }],
  "vars": {
    "EMAIL_FROM": "login@auth.elyteaparty.com",
    // Moderators: they see hidden skins, restore or remove them, and get report mail.
    "ADMIN_EMAILS": "loveyouforever36@gmail.com"
  },
  // SECRET (wrangler secret put SECRET) keys code and reporter hashes.
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "elyteaparty.com", "custom_domain": true },
    { "pattern": "www.elyteaparty.com", "custom_domain": true }
  ]
}
